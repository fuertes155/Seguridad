# Exclusiones de Git: dependencias, compilación, datos privados y resultados locales.
# .runtime contiene credenciales y evidencia; nunca debe formar parte del código compartido.
node_modules/
dist/
.venv/
.runtime/
__pycache__/
.pytest_cache/
*.pyc
*.tsbuildinfo
output/
.env
.env.*
!.env.example
.mypy_cache/
*.log
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
